{
  "name": "bashotori",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "account_id": "d2874089eebcda705bf220d39f117aec",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {},
  // DEEPSEEK_API_KEY は secret で入れる。
  // ログインは D1 の app_users。最初の管理者は次のどちらかで作る。
  // 1. secret の ADMIN_EMAIL と ADMIN_PASSWORD を設定し、そのメールとパスワードでログインする。
  // 2. secret の AUTH_SETUP_TOKEN を設定し、POST /api/auth/setup に X-Setup-Token を付ける。
  // Supabase のユーザーは引き継がない。管理者を作ったあとに POST /api/auth/users で追加する。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bashotori",
      "database_id": "cb310bdf-bd02-4d17-85bc-2209eb20ec92"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bashotori-photos"
    }
  ]
}
