{
  "name": "bashotori",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-03",
  "account_id": "d2874089eebcda705bf220d39f117aec",
  "workers_dev": true,
  "keep_vars": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  },
  "vars": {
    "SUPABASE_URL": "https://nfxzluqlprkelwociuaa.supabase.co"
  },
  // SUPABASE_PUBLISHABLE_KEY は `wrangler secret put SUPABASE_PUBLISHABLE_KEY` で入れる。
  // ログイン確認だけに使い、Supabase のテーブルには書き込まない。
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "bashotori",
      "database_id": "cb310bdf-bd02-4d17-85bc-2209eb20ec92"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PHOTOS",
      "bucket_name": "bashotori-photos"
    }
  ]
}
